{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run CLI (Folder)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "args": [
                "scan-directory",
                "${workspaceFolder}/books",
            ],
            "program": "cmd/cli/main.go",
            "envFile": "${workspaceFolder}/.env",
            "showLog": true
        },
        {
            "name": "Run CLI (File)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "args": [
                "process-file",
                "${workspaceFolder}/books/Alice's Adventures in Wonderland by Lewis Carroll.epub",
            ],
            "program": "cmd/cli/main.go",
            "envFile": "${workspaceFolder}/.env",
            "showLog": true
        },
        {
            "name": "Run CLI (Search)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "args": [
                "goodreads-search",
                "Alice's Adventures in Wonderland",
            ],
            "program": "cmd/cli/main.go",
            "envFile": "${workspaceFolder}/.env",
            "showLog": true
        },
        {
            "name": "Run Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "cmd/server/main.go",
            "envFile": "${workspaceFolder}/.env",
            "showLog": true
        },
    ]
}