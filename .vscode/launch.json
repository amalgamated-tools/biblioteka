{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run CLI (Folder)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "args": [
                "scan-directory",
                "${workspaceFolder}/books"
            ],
            "program": "cmd/cli/main.go",
            "envFile": "${workspaceFolder}/.env",
            "showLog": true
        },
        {
            "name": "Run CLI (AZW3)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "args": [
                "process-file",
                "${workspaceFolder}/books/theprince.azw3"
            ],
            "program": "cmd/cli/main.go",
            "envFile": "${workspaceFolder}/.env",
            "showLog": true
        },
        {
