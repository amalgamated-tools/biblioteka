# INITIAL_ADMIN_PASSWORD=changeme
# INITIAL_ADMIN_NAME=Admin
LOG_LEVEL=info
LOG_FORMAT=json
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/oidc/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls
WEBAUTHN_RP_ID=localhost
