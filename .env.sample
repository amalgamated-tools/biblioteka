PORT=8080
DATABASE_URL=
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret_here
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=
SECURE_COOKIES=false
DISABLE_SIGNUP=false
